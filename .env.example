# BreatheWise - Environment Configuration
# Note: BreatheWise is fully functional even without an API key!
# When GEMINI_API_KEY is not provided, the application automatically uses its
# built-in local rule-based environmental intelligence engine.

# Google Gemini API Key (Optional but recommended for full GenAI reasoning)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Application Base URL (Optional, defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
